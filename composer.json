{
    "name": "daika7ana/simple-collections",
    "description": "Dependency-free Collection and LazyCollection for PHP 8.3+.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "collection",
        "lazy",
        "laravel",
        "array"
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Daika7ana\\SimpleCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daika7ana\\SimpleCollections\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/pint --test",
        "stan": "@php vendor/bin/phpstan --no-progress",
        "test": "@php vendor/bin/phpunit",
        "ci": [
            "@pint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
